# ── Entorno ───────────────────────────────────────────────────────────────────
# development | staging | production. Decide modelos, proyecto LangSmith y logs
# (ver lib/config.ts y ENVIRONMENTS.md). Desacoplado de NODE_ENV.
APP_ENV=development

# ── Base de datos ─────────────────────────────────────────────────────────────
# Supabase / PostgreSQL — Transaction Pooler (puerto 6543)
# Usa un proyecto/BD distinto por entorno (dev / staging / producción).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# ── Autenticación admin ───────────────────────────────────────────────────────
ADMIN_SECRET=cambia_esta_clave_secreta
JWT_SECRET=cambia_este_jwt_secreto

# ── Groq (LLM vía LangChain / ChatGroq) ──────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Google Generative AI (embeddings text-embedding-004 para RAG) ─────────────
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=...

# ── LangSmith (tracing, datasets y evaluación) ───────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=dtecnoc-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Gmail OAuth2 ──────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=...apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-...
GMAIL_REFRESH_TOKEN=1//...
GMAIL_USER=tu_cuenta@gmail.com

# Proveedor por defecto al que se envían solicitudes de cotización
DEFAULT_SUPPLIER_EMAIL=proveedor@empresa.com

# Gmail Pub/Sub (solo producción — no funciona en localhost)
GMAIL_PUBSUB_TOPIC=projects/TU_PROYECTO/topics/gmail-notifications

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Secreto que Vercel envía como "Authorization: Bearer <CRON_SECRET>" en /api/cron/*
CRON_SECRET=cambia_este_cron_secreto

# ── Supabase (RAG / embeddings) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
